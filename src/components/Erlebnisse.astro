<section class="section" id="erlebnisse">
  <div class="wrapper">
    <div class="section-header fade-in">
      <svg class="silhouette-inline" viewBox="0 0 253 25" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M153.04 21.24 137.98 6.31l-4.71 3.09-6.59-8.36-6.82 10.51-7.53-3.41-12.24 13.1L0 23.82h100.82l11.51-12.84 9.14 5.01 5.21-10.65 5.65 8.71 5.65-4.62 14.33 14.39h100.81z"/></svg>
      <h2>Erlebnisse rund ums Randolins</h2>
      <p>Ob verschneite Pisten oder glitzernde Seen – das Engadin bietet zu jeder Jahreszeit unvergessliche Momente.</p>
    </div>
    <div class="season-toggle fade-in" role="group" aria-label="Saison wählen">
      <button type="button" id="btn-winter" aria-pressed="true" data-season="winter">Winter</button>
      <button type="button" id="btn-summer" aria-pressed="false" data-season="summer">Sommer</button>
    </div>
    <div class="season-grid active" id="grid-winter" role="region" aria-label="Winter-Erlebnisse">
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/ski-corviglia.jpg" alt="Skifahren auf Corviglia" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"><span class="experience-card__badge">Ab Haustür</span></div><div class="experience-card__body"><h4>Skigebiet Corviglia</h4><p>155 Pistenkilometer und der legendäre Blick vom Piz Nair. Die Abfahrt endet über einen Schleichweg direkt vor der Haustür.</p><div class="experience-card__meta"><span>300 m zum Lift</span><span>Bis 3'057 m</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/langlauf.jpg" alt="Langlaufen im Engadin" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"></div><div class="experience-card__body"><h4>Langlauf-Paradies</h4><p>225 km Skating- und 233 km klassische Loipen zwischen zugefrorenen Seen. In der Morgenstille knirscht nur der Schnee.</p><div class="experience-card__meta"><span>2 km zum Einstieg</span><span>458 km Loipen</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/winterwandern.jpg" alt="Winterwandern ins Val Roseg" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"><span class="experience-card__badge">Direkt ab Hotel</span></div><div class="experience-card__body"><h4>Winterwandern</h4><p>150 km geräumte Wege direkt vor der Tür. Durch verschneite Wälder, entlang gefrorener Seen – einfach los.</p><div class="experience-card__meta"><span>0 km – ab Haust��r</span><span>150 km Wege</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/olympia-bob.jpg" alt="Olympia Bob Run St. Moritz" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"></div><div class="experience-card__body"><h4>Olympia Bob Run</h4><p>Die einzige Natureisbahn der Welt. 14 Kurven, bis zu 135 km/h – auch als Gast-Passagier erlebbar.</p><div class="experience-card__meta"><span>4 km entfernt</span><span>Seit 1904</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/skipisten.jpg" alt="Skipisten im Engadin" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"></div><div class="experience-card__body"><h4>Skigebiet Corvatsch</h4><p>Höchster Punkt auf 3'303 m. Weite Abfahrten, weniger Trubel – Schwünge mit Weitsicht statt Warteschlange.</p><div class="experience-card__meta"><span>7 km entfernt</span><span>Bis 3'303 m</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/schwarzeis.jpg" alt="Schwarzeis auf dem Lej da Silvaplauna" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"></div><div class="experience-card__body"><h4>Eislauf auf dem See</h4><p>Schlittschuh auf Natureis, mit Blick auf die verschneite Bergkulisse – so einfach, so perfekt.</p><div class="experience-card__meta"><span>3 km ins Dorf</span><span>Jan – Feb</span></div></div></article>
    </div>
    <div class="season-grid" id="grid-summer" role="region" aria-label="Sommer-Erlebnisse">
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/silvaplanersee.jpg" alt="Wandern am Lej da Silvaplauna" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"></div><div class="experience-card__body"><h4>Seenwanderung</h4><p>Vier Seen wie flüssiges Aquamarin zwischen Lärchenwäldern – jeder in einem anderen Blauton, keiner wie der andere.</p><div class="experience-card__meta"><span>3 km zum See</span><span>15 km Route</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/muottas-muragl.jpg" alt="Aussicht von Muottas Muragl" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"><span class="experience-card__badge">Top-Aussicht</span></div><div class="experience-card__body"><h4>Muottas Muragl</h4><p>Auf 2'456 m das schönste Panorama des Engadins. Bei Sonnenuntergang versteht man, warum Künstler hier den Atem anhielten.</p><div class="experience-card__meta"><span>8 km + Bahn</span><span>2'456 m ü.M.</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/bike-corviglia.jpg" alt="WM-Flow-Trail auf Corviglia" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"></div><div class="experience-card__body"><h4>Mountainbike Trails</h4><p>Flow Trails für Einsteiger, technische Strecken für Könner – 400 km Bikerouten im ganzen Engadin.</p><div class="experience-card__meta"><span>300 m zum Lift</span><span>400 km Routen</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/nationalpark.jpg" alt="Nationalpark Val Trupchun" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"></div><div class="experience-card__body"><h4>Nationalpark</h4><p>170 km² unberührte Wildnis – der älteste Nationalpark der Alpen. Steinböcke, Bartgeier und zeitlose Stille.</p><div class="experience-card__meta"><span>35 km (40 Min.)</span><span>Seit 1914</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/cavloc.jpg" alt="Lägh da Cavloc" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"></div><div class="experience-card__body"><h4>Gletscherwelt Diavolezza</h4><p>Wo ewiges Eis auf den Sommer trifft. Die Gletscherzunge des Morteratsch, flankiert von Viertausendern.</p><div class="experience-card__meta"><span>20 km (25 Min.)</span><span>Bis 3'900 m</span></div></div></article>
      <article class="experience-card fade-in"><div class="experience-card__img"><img src="/images/randolins/stazersee.jpg" alt="Morgennebel am Lej da Staz" style="width:100%;height:100%;object-fit:cover;aspect-ratio:16/10;min-height:160px;" loading="lazy"></div><div class="experience-card__body"><h4>Stazersee &amp; Arvenwald</h4><p>Ein verborgener Waldsee, umgeben von uralten Arven. Ein Ort, an dem man den Duft von Harz einatmet.</p><div class="experience-card__meta"><span>2 km zu Fuss</span><span>Geheimtipp</span></div></div></article>
    </div>
  </div>
</section>
